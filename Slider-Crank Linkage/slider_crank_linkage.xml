<mujoco model="Four-Bar Linkage">
	
	<worldbody>

		<geom type="plane" pos="0 0 -2" size="0 0 0.1" rgba="1 1 1 1"/>
		<light pos="0 0 20" dir="0 0 -1"/>
		
		<body name="input">
			<joint name="input_joint" type="hinge" axis="0 1 0"/>
			<geom type="capsule" fromto="0 0 0 0 0 1" size="0.05" rgba="1 0 0 1"/>

			<body>
				<joint type="hinge" pos="0 0 1" axis="0 1 0"/>
				<geom type="capsule" fromto="0 0 1 2 0 3" size="0.05" rgba="0 0 1 1"/>
				<site name="site_coupler" type="sphere" pos="2 0 3" size="0.05"/>
				
			</body>
			
		</body>
		
		<body pos="2 0 0">
			<joint name="output_joint" type="slide" axis="1 0 0"/>
			<geom type="box" pos="0 0 0" size=" 0.3 0.3 0.2" rgba="0 1 0 1"/>
			<site name="site_slider" type="sphere" pos="0 0 0" size="0.05"/>
		</body>
		
	</worldbody>

	<equality>
		<connect site1="site_coupler" site2="site_slider"/>
	</equality>

	<sensor>
		<jointpos joint="output_joint"/>
	</sensor>

	<actuator>
		<motor joint="input_joint" ctrlrange="-500 +500"/>
	</actuator>
	
</mujoco>